Options -Indexes
RewriteEngine On
RewriteBase /

# Serve existing files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Rewrite /page and /page/ to /page.html (only paths without dots, so images/js/css are unaffected)
RewriteRule ^([^.]+)/?$ /$1.html [L]

ErrorDocument 404 /404.html
